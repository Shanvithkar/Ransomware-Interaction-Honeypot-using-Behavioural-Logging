python3 -m venv cowrie-env
source cowrie-env/bin/activate

### Step 4: Install Dependencies
pip install -r requirements.txt --break-system-packages

### Step 5: Configure Cowrie
cp etc/cowrie.cfg.dist etc/cowrie.cfg
nano etc/cowrie.cfg

